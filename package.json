{
  "name": "trip-planner",
  "productName": "Trip Planner",
  "version": "0.1.0",
  "description": "Shanghai / Suzhou / Hangzhou trip planner \u2014 map of places + multi-city itinerary planning.",
  "main": "main.js",
  "scripts": {
    "start": "node tools/dev.js",
    "dev": "node tools/dev.js",
    "app": "electron .",
    "backend": "npm --prefix backend start",
    "setup": "npm --prefix backend install && node backend/scripts/setup.js",
    "db:reset": "npm --prefix backend run reset",
    "postinstall": "node tools/postinstall.js",
    "dist:mac": "npx --yes electron-builder@26.15.3 --mac",
    "dist:win": "npx --yes electron-builder@26.15.3 --win",
    "test": "npm --prefix backend test"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.2.0"
  },
  "build": {
    "appId": "com.gerry.tripplanner",
    "productName": "Trip Planner",
    "files": [
      "main.js",
      "frontend/**/*"
    ],
    "mac": {
      "category": "public.app-category.travel",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  },
  "overrides": {
    "fast-uri": "^3.1.7",
    "@xmldom/xmldom": "^0.8.15"
  },
  "engines": {
    "node": ">=22"
  }
}
