# ---------------------------------------------------------------------------
#  Trip Planner backend
#  Copy to .env. Nothing here is secret in development; everything marked
#  (prod) must be set before NODE_ENV=production will start at all.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4177
DB_FILE=./data/tripplanner.db
LOG_LEVEL=debug

# --- authentication -------------------------------------------------------
# bypass  : every request runs as DEV_USER_EMAIL. Testing only.
#           config.js refuses to boot with this in production.
# session : the real path (routes are stubbed until you implement them).
AUTH_MODE=bypass
DEV_USER_EMAIL=you@local

# (prod) 32+ random chars:  openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_DAYS=30
INVITE_TTL_DAYS=14

# --- network --------------------------------------------------------------
# (prod) Exact origins, comma separated. No wildcards — the server rejects '*'.
# Left blank in development it allows the Electron shell (file://) and localhost.
CORS_ORIGINS=

# Number of proxies in front of this process. Cloudflare alone = 1.
# Getting this wrong means rate limiting keys on the proxy, not the client.
TRUST_PROXY=1

# --- abuse limits (per client IP, per window) ------------------------------
RATE_WINDOW_MS=60000
RATE_MAX=300          # all requests
WRITE_RATE_MAX=60     # anything that mutates
AUTH_RATE_MAX=10      # sign-in attempts
BODY_LIMIT=1mb
